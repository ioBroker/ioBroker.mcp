{
    "type": "tabs",
    "i18n": true,
    "items": {
        "_server": {
            "type": "panel",
            "label": "Server Configuration",
            "items": {
                "webInstance": {
                    "type": "instance",
                    "label": "Extend WEB adapter",
                    "all": true,
                    "sm": 12,
                    "adapter": "web"
                },
                "bind": {
                    "newLine": true,
                    "type": "text",
                    "label": "Bind Address",
                    "default": "0.0.0.0",
                    "hidden": "!!data.webInstance",
                    "help": "IP address to bind the server to (0.0.0.0 for all interfaces)",
                    "sm": 12,
                    "md": 8,
                    "lg": 4
                },
                "port": {
                    "type": "number",
                    "label": "Port",
                    "min": 1,
                    "max": 65535,
                    "default": 8011,
                    "hidden": "!!data.webInstance",
                    "help": "Port on which the web server will listen",
                    "sm": 12,
                    "md": 4,
                    "lg": 2
                }
            }
        },
        "_auth": {
            "type": "panel",
            "label": "Authentication",
            "hidden": "!!data.webInstance",
            "items": {
                "auth": {
                    "type": "checkbox",
                    "label": "Enable Authentication",
                    "default": false,
                    "help": "Enable ioBroker user authentication for the web server"
                },
                "defaultUser": {
                    "type": "text",
                    "label": "Default User",
                    "default": "admin",
                    "hidden": "!data.auth",
                    "help": "Default user for authentication (e.g., 'admin')"
                }
            }
        },
        "_oauth": {
            "type": "panel",
            "label": "OAuth",
            "items": {
                "_oauthIntro": {
                    "type": "infoBox",
                    "boxType": "info",
                    "newLine": true,
                    "sm": 12,
                    "text": "MCP clients such as Claude Desktop connect through a browser login instead of a token you create by hand. The client never sees the ioBroker password and discovers the server on its own."
                },
                "oauth": {
                    "type": "checkbox",
                    "newLine": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "label": "Enable OAuth (browser login)",
                    "default": false,
                    "disabled": "!data.webInstance && !data.auth",
                    "help": "Standalone mode requires 'Enable Authentication'."
                },
                "_oauthNeedsAuth": {
                    "type": "infoBox",
                    "boxType": "warning",
                    "newLine": true,
                    "sm": 12,
                    "text": "Enable 'Authentication' first — without it the MCP endpoint is open and OAuth has nothing to protect.",
                    "hidden": "!!data.webInstance || !!data.auth"
                },
                "_oauthExtensionHint": {
                    "type": "infoBox",
                    "boxType": "warning",
                    "newLine": true,
                    "sm": 12,
                    "text": "As a web extension the selected web instance provides the login: OAuth must be enabled there as well ('Allow third-party clients'), otherwise MCP clients only get a redirect to the login page, which they cannot use.",
                    "hidden": "!data.webInstance || !data.oauth"
                },
                "_oauthHttpsWarning": {
                    "type": "infoBox",
                    "boxType": "warning",
                    "newLine": true,
                    "sm": 12,
                    "text": "OAuth without HTTPS: remote MCP clients refuse plain http:// and will not be able to connect. Enable SSL, or put this server behind an https reverse proxy and set the public URL.",
                    "hidden": "!!data.webInstance || !data.auth || !data.oauth || !!data.secure || (data.publicUrl || '').startsWith('https://')"
                },
                "publicUrl": {
                    "type": "text",
                    "newLine": true,
                    "sm": 12,
                    "md": 8,
                    "lg": 6,
                    "label": "Public URL",
                    "default": "",
                    "placeholder": "https://iobroker.example.com",
                    "hidden": "!data.oauth",
                    "help": "Externally reachable address of this server, without a path. Required behind a reverse proxy. As a web extension it must match the public URL of the web instance.",
                    "validator": "!data.publicUrl || /^https?:\\/\\/[^\\s/?#]+$/.test(data.publicUrl.replace(/\\/+$/, ''))",
                    "validatorErrorText": "Enter an address like https://iobroker.example.com - scheme and host only, no path",
                    "validatorNoSaveOnError": true
                },
                "oauthDynamicRegistration": {
                    "type": "checkbox",
                    "newLine": true,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "label": "Allow client self-registration",
                    "default": true,
                    "hidden": "!!data.webInstance || !data.oauth",
                    "help": "MCP clients register themselves automatically. With this off, every client has to be registered by hand before it can connect."
                }
            }
        },
        "_permissions": {
            "type": "panel",
            "label": "Permissions",
            "items": {
                "allowSetState": {
                    "type": "checkbox",
                    "label": "Allow setting states",
                    "default": true,
                    "help": "Allow MCP clients to write state values (set_state tool)"
                },
                "allowObjectChange": {
                    "type": "checkbox",
                    "label": "Allow object/file changes",
                    "default": false,
                    "help": "Allow MCP clients to create/modify objects and write files (set_object, write_file tools). Off by default."
                }
            }
        },
        "_ssl": {
            "type": "panel",
            "label": "SSL/TLS Configuration",
            "hidden": "!!data.webInstance",
            "items": {
                "secure": {
                    "type": "checkbox",
                    "label": "Enable HTTPS",
                    "default": false,
                    "help": "Enable HTTPS/SSL for secure connections"
                },
                "certPublic": {
                    "type": "certificate",
                    "label": "Public Certificate",
                    "certType": "public",
                    "hidden": "!data.secure",
                    "help": "Path to the public certificate file"
                },
                "certPrivate": {
                    "type": "certificate",
                    "label": "Private Key",
                    "certType": "private",
                    "hidden": "!data.secure",
                    "help": "Path to the private key file"
                },
                "certChained": {
                    "type": "certificate",
                    "label": "Chained Certificate",
                    "certType": "chained",
                    "hidden": "!data.secure",
                    "help": "Path to the chained certificate file (optional)"
                }
            }
        }
    }
}
